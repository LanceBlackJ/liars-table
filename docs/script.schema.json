{
  "$defs": {
    "ActBlock": {
      "description": "某个角色在第 N 幕开场时多收到的一页剧本。\n\n三幕本的核心：第二幕不是「再搜一轮」，而是每个人收到一段**只有自己知道**的\n新信息，而且它通常会推翻他第一幕里说过的话——所有人的证词要重新对一遍。\n线下本能撑几个小时，靠的正是同一批信息被反复推翻重估，不是内容多。",
      "properties": {
        "act": {
          "title": "Act",
          "type": "integer"
        },
        "title": {
          "default": "",
          "title": "Title",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "observations": {
          "items": {
            "type": "string"
          },
          "title": "Observations",
          "type": "array"
        },
        "goals": {
          "items": {
            "$ref": "#/$defs/PersonalGoal"
          },
          "title": "Goals",
          "type": "array"
        },
        "secret_add": {
          "default": "",
          "title": "Secret Add",
          "type": "string"
        },
        "retract_goals": {
          "items": {
            "type": "string"
          },
          "title": "Retract Goals",
          "type": "array"
        },
        "restore_slots": {
          "items": {
            "type": "string"
          },
          "title": "Restore Slots",
          "type": "array"
        },
        "grant_clues": {
          "items": {
            "type": "string"
          },
          "title": "Grant Clues",
          "type": "array"
        }
      },
      "required": [
        "act",
        "text"
      ],
      "title": "ActBlock",
      "type": "object"
    },
    "AvatarSpec": {
