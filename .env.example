# 复制成 .env 后填写。.env 已被 .gitignore 忽略，不会进版本库。
# 也可以不创建这个文件：启动后在页面右上角 ⚙「模型设置」里填，效果一样。

# 任何 OpenAI 兼容的接口（支持 POST {SG_BASE_URL}/chat/completions）。
# 下面是几个常见的，换一个注释掉的即可（模型名以服务商文档为准）：
#   DeepSeek      https://api.deepseek.com/v1                         deepseek-chat / deepseek-reasoner
#   阿里云百炼    https://dashscope.aliyuncs.com/compatible-mode/v1   qwen-plus / qwen-max
#   硅基流动      https://api.siliconflow.cn/v1                       Qwen/Qwen2.5-72B-Instruct
#   OpenAI        https://api.openai.com/v1                           gpt-4o-mini / gpt-4o
SG_BASE_URL=https://api.deepseek.com/v1
SG_API_KEY=sk-你的密钥

# 对话用的模型：角色扮演、出题。要快、中文好、JSON 稳。
SG_MODEL_CHAT=deepseek-chat

# 生成本子的设定阶段 / 可解性校验用的模型：要更强的推理。推理模型会输出 <think>，代码里已自动剥离。
SG_MODEL_REASON=deepseek-reasoner

# 离线模式：1 = 不调用任何远端，AI 说预置台词，整个流程照跑（适合开发、试玩界面）。
# 不填密钥也会自动进入离线模式。
SG_MOCK=0

# 单次请求超时（秒）。推理模型较慢，建议给足。
SG_TIMEOUT=120

# 1 = 忽略系统代理直连。接口在内网、而本机设了 HTTP_PROXY（Clash/V2Ray 之类）时用；
# 连海外服务且需要代理时保持 0。
SG_BYPASS_PROXY=0

# 每分钟最多发多少次请求（客户端限流）。服务商不限流的话可以调大。
SG_RATE_PER_MIN=18
